# Analyses the generated output at level 9, which is the claim every emitter has to meet. It runs
# separately from the main analysis because the output targets PHP 8.4 (property hooks), while
# the codegen itself still supports 8.3. Nothing commits the output: `composer phpstan-generated`
# writes it to build/generated-output first.
parameters:
    level: 9
    phpVersion: 80400
    paths:
        - build/generated-output/generated
        - build/generated-output/paginators
        - build/generated-output/witness
        - build/generated-output/form-fields
        - build/generated-output/unions
        # Asserts the page type a menu query's pickers leave it reading.
        - tests/GeneratedTypes
    bootstrapFiles:
        - build/generated-output/generated/autoload.php
        - build/generated-output/paginators/autoload.php
        - build/generated-output/witness/autoload.php
        - build/generated-output/form-fields/autoload.php
        - build/generated-output/unions/autoload.php
    tmpDir: .phpstan.cache/generated
    treatPhpDocTypesAsCertain: false
