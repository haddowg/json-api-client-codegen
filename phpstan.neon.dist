# tests/phpstan-unions.php writes the generated output and adds its 8.3-target suite here.
includes:
    - tests/phpstan-unions.php

parameters:
    level: 9
    paths:
        - src
        - tests
        - bin/json-api-client-codegen
        - bin/export-generated-output.php
    excludePaths:
        - tests/fixtures
        # The type assertions made against the generated output are analysed with it, by
        # phpstan.generated.neon, since the output targets PHP 8.4.
        - tests/GeneratedTypes
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
