# Normalise line endings
* text=auto eol=lf

# Keep the binary executable when the dist archive is unpacked
/bin/json-api-client-codegen text eol=lf

# Exclude development & meta files from the Composer dist archive
/.github/                      export-ignore
/docs/                         export-ignore
/tests/                        export-ignore
/.gitattributes                export-ignore
/.gitignore                    export-ignore
/.php-cs-fixer.dist.php        export-ignore
/phpstan.neon.dist             export-ignore
/phpunit.xml.dist              export-ignore
/.release-please-manifest.json export-ignore
/release-please-config.json    export-ignore
/.pre-commit-config.yaml       export-ignore
/CONTRIBUTING.md               export-ignore
/CLAUDE.md                     export-ignore
/CONTEXT.md                    export-ignore
